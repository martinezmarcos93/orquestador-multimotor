{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinezmarcos93/orquestador-opencode/blob/main/schemas/estado.v1.schema.json",
  "title": "Estado de una corrida del orquestador",
  "description": "Contrato mínimo para estado.json. Se permiten campos adicionales para mantener compatibilidad hacia delante.",
  "type": "object",
  "required": [
    "schema_version",
    "inicio_utc",
    "fin_utc",
    "resultado",
    "siguiente_accion"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inicio_utc": {
      "type": "string",
      "format": "date-time"
    },
    "fin_utc": {
      "type": "string",
      "format": "date-time"
    },
    "resultado": {
      "type": "string",
      "minLength": 1
    },
    "siguiente_accion": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string"
    },
    "proyecto": {
      "type": "string"
    },
    "agente": {
      "type": "string"
    },
    "ronda": {
      "type": "integer",
      "minimum": 1
    },
    "run": {
      "type": "string"
    },
    "estado_json": {
      "type": "string"
    },
    "base_sha": {
      "type": "string"
    },
    "head_sha_inicio": {
      "type": "string"
    },
    "head_sha_fin": {
      "type": "string"
    },
    "base_movida": {
      "type": "boolean"
    },
    "main_intacto": {
      "type": "boolean"
    },
    "errores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "advertencias": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
